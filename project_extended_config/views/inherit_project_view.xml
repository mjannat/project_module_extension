<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Inherit the project form view to add custom team-related fields -->
        <record id="inherited_project_view_form_inherit" model="ir.ui.view">
            <field name="name">project.project.form</field>
            <field name="model">project.project</field>
            <!-- Inherit the standard project form view -->
            <field name="inherit_id" ref="project.edit_project"/>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <!-- Insert custom fields before the 'partner_id' field in the form -->
                <xpath expr="//field[@name='partner_id']" position="before">
                    <field name="team_id" string="Team"/>
                    <field name="team_manager_id"/>
                    <field name="team_member_ids" widget="many2many_tags"/>
                </xpath>
            </field>
        </record>

