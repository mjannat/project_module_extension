        <!-- Custom action for opening project list view pre-filtered for team members -->
        <record id="action_custom_project_view" model="ir.actions.act_window">
            <field name="name">Project List</field>
            <field name="res_model">project.project</field>
            <field name="view_mode">tree,form</field>
            <field name="type">ir.actions.act_window</field>
            <!-- Show only projects where current user is in team_member_ids -->
            <field name="domain">[('team_member_ids', 'in', uid)]</field>
            <!-- Help message shown when there are no projects -->
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first team configuration
                </p>
                <p>
                    Configure teams for project management with managers and members.
                </p>
            </field>
        </record>

    </data>
