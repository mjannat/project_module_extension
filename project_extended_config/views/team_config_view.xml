<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="team_config_form_view" model="ir.ui.view">
            <field name="name">team.config.form</field>
            <field name="model">team.config</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="oe_title">
                            <label for="name" string="Team Name"/>
                            <h1>
                                <field name="name" placeholder="Team Name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="team_manager_id"/>
                                <field name="department_id"/>
                                <field name="company_id"/>
                            </group>
                            <group>
                                <field name="system_code"/>
                                <field name="team_member_ids" widget="many2many_tags"/>
                            </group>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="team_config_tree_view" model="ir.ui.view">
            <field name="name">team.config.tree</field>
            <field name="model">team.config</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="team_manager_id"/>
                    <field name="department_id"/>
                    <field name="system_code"/>
                    <field name="team_member_ids" widget="many2many_tags"/>
                </tree>
            </field>
        </record>

        <record id="action_team_config" model="ir.actions.act_window">
            <field name="name">Team Configuration</field>
            <field name="res_model">team.config</field>
            <field name="view_mode">tree,form</field>
            <field name="type">ir.actions.act_window</field>
            <field name="context">{'search_default_my_teams': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first team configuration
                </p>
                <p>
                    Configure teams for project management with managers and members.
                </p>
            </field>
        </record>
    </data>
</odoo>